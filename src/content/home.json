  "items": [
   {
    "author": "Nazlı Öztürk",
    "when": "8 ay önce",
    "text": "Fuar standımız için birlikte çalıştık ve gerçekten memnun kaldık. Süreç boyunca iletişimde hiçbir problem yaşamadık, her şey hızlı ve planlı ilerledi. Kurulum ve operasyon kısmı da oldukça sorunsuzdu. Standın kalitesi çok iyiydi, fuar boyunca birçok kişiden tasarımla ilgili güzel yorumlar aldık. Emeği geçen herkese teşekkür ederiz."
   },
   {
    "author": "Kerim Yeşilyurt",
    "when": "8 ay önce",
    "text": "Kuyumculuk fuarı için 3 yıldır işbirliği yapıyoruz. Deneyimli ve yenilikçi tasarımlar sunan bir ekip. İşin başlangıcından bitimine kadar titizlikle ilgileniyorlar. Gönül rahatlığıyla tavsiye ediyorum!"
   },
   {
    "author": "Murat Boylu",
    "when": "bir yıl önce",
    "text": "Tasarım ve yeni trend standlar konusunda işini titizlikle ve hakkıyla yapan genç, dinamik bir ekip. Gönül rahatlığıyla tavsiye ediyorum!"
   },
   {
    "author": "Bela Brons",
    "when": "bir yıl önce",
    "text": "It was a pleasue working with Wawa Interiors. Clear and quick communication. Very happy with manager Zehra, she made our exhibition experience very comfortable and professional. Will be glad to work together again"
   }
  ]
 },
 "faq": [
  {
   "q": "Tasarım süreci ne kadar sürer?",
   "a": "Proje türüne, metrekareye ve teslim tarihine göre değişir. İlk görüşmede kapsamı netleştirir, size baştan net bir takvim paylaşırız."
  },
  {
   "q": "Üretim ve kurulum hangi ülkelerde?",
   "a": "Üretim İstanbul'daki atölyemizde yapılır. Avrupa, Birleşik Krallık, Amerika, Ortadoğu ve Afrika'da kurulumu kendi ekibimiz ve lojistik planla yönetiriz."
  },
  {
   "q": "İç mimar ücreti nasıl belirlenir?",
   "a": "Ücret metrekareye ve proje kapsamına göre belirlenir: tasarım karmaşıklığı, malzeme seviyesi, özel imalatlar ve teslim tarihi. İlk görüşmede kapsamı ve bütçe aralığını netleştiririz."
  },
  {
   "q": "Nakliye ve montaj dahil mi?",
   "a": "Anahtar teslim projelerde üretim, nakliye ve montaj tek elden yönetilir. Dahil olan kalemler proje başında yazılı olarak netleşir."
  },
  {
   "q": "Başlamak için neye ihtiyacınız var?",
   "a": "Proje türü, ölçüler, lokasyon, teslim ya da fuar tarihi ve beğendiğiniz referanslar yeterli. Gerisini birlikte kurgularız."
  }
 ],
