# Ücret hesaplayıcı telefon doğrulaması
# SMS sağlayıcısı tanımlı değilken (yalnızca geliştirmede) test modu: SMS gönderilmez, kod 123456'dır
OTP_SECRET=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# Verimor (wawamobilya sitesiyle ayni hesap; tanimliysa Netgsm yerine bu kullanilir)
VERIMOR_SMS_USERNAME=
VERIMOR_SMS_PASSWORD=
VERIMOR_SMS_HEADER=
# Verimor yalnizca izinli IP kabul eder: sabit IP li aktarici anahtari (wawamobilya ile ayni)
SMS_RELAY_KEY=
# SMS_RELAY_KEY tanımlıysa zorunlu: aktarıcının https adresi (kodda sabit adres yoktur)
VERIMOR_SMS_RELAY_URL=

# Doğrulanan hesapların e-postayla iletilmesi (Resend); boşken yalnızca sunucu günlüğüne yazılır
RESEND_API_KEY=
LEAD_EMAIL_TO=info@wawainteriors.com
LEAD_EMAIL_FROM=

# Yapay zeka görsel üretimi (Google Gemini). Boşsa stüdyo talebi yalnızca ekibe iletir.
GEMINI_API_KEY=
AI_IMAGE_MODEL=gemini-2.5-flash-image
# Panelde kaydedilen projelerin İngilizce ve Almanca çevirisi (aynı anahtar)
AI_TEXT_MODEL=gemini-2.5-flash

# Yonetim paneli (/yonetimpanel/). ADMIN_PASSWORD en az 12, ADMIN_SECRET en az 32 karakter degilse panel kapalidir.
ADMIN_PASSWORD=
# Oturum imzasi: uzun, rastgele ve OTP_SECRET'ten farkli olmali (zorunlu)
ADMIN_SECRET=
# Bu degeri degistirmek (or. 0 -> 1) tum acik panel oturumlarini kapatir
ADMIN_SESSION_EPOCH=0
# Panelin icerigi kaydettigi GitHub deposu: yazma izinli token, "sahip/depo", dal (varsayilan main)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Paylasilan hiz siniri deposu (Upstash Redis REST ya da Vercel KV). Bos ise sinirlar her sunucu kopyasinda ayri tutulur.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot dogrulamasi (formlar, SMS kodu, yapay zeka onizlemesi). Bos ise dogrulama atlanir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Panelden MP4 video yukleme (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Site Cloudflare arkasindaysa 1. Istege bagli: Cloudflare'in her istege ekledigi x-origin-auth basliginin degeri
BEHIND_CLOUDFLARE=
CF_ORIGIN_SECRET=
